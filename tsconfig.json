{
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowJs": true,
    "compilerOptions": {
        "skipLibCheck": true,
        "noEmitOnError": false,
        "experimentalDecorators": true,
        "target": "ES2022",
        "module": "commonjs",
        "declaration": true,
        "outDir": "./lib",
        "strict": false,
        "types": [
            "node",
            "@formidablejs/framework"
        ]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "**/__tests__/*"
    ]
}